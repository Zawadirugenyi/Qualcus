# Public URL of this website (used for canonical URLs, Open Graph and sitemap).
# In production set it to your real domain, e.g. https://qualcus.com
VITE_SITE_URL=http://localhost:3000

# Base URL of the Payload CMS backend (admin + API).
# Leave empty in development so requests go through the Vite proxy.
VITE_API_URL=

# Where the Vite dev server proxies /api and /media (the CMS).
VITE_CMS_URL=http://localhost:3001
