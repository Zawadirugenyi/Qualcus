# ============================================
# CMS (Payload) — copy to cms/.env and edit
# ============================================

# --- Database -------------------------------------------------
# Local dev (SQLite, file next to the cms folder):
DATABASE_URI=file:./qualcus.db
#
# Production (SQLite on the server) — absolute path:
# DATABASE_URI=file:/home/qualcus/app/cms/qualcus.db
#
# Or managed Postgres (Neon direct host / Supabase session pooler, port 5432):
# DATABASE_URI=postgresql://user:pass@host:5432/db

# --- Payload --------------------------------------------------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- Admin user (created by the seed script) ------------------
ADMIN_EMAIL=admin@qualcus.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Public URL of the React site -----------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Only needed when the CMS is on a DIFFERENT domain ---------
# Allows the React site to call the API (CORS + CSRF).
# Leave empty when the CMS is behind the same domain.
CMS_ORIGIN=

# --- Where uploaded media files are stored ----------------------
# Use an absolute path in production.
MEDIA_DIR=
