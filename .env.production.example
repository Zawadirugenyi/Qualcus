# ============================================================
#  Production build settings — copy to .env.production
#  (Vite reads .env.production automatically when you run `npm run build`)
# ============================================================

# Public URL of the site
VITE_SITE_URL=https://qualcus.com

# Where the CMS API lives.
# Leave EMPTY when the CMS is on the same domain (recommended):
#   the app then calls /api/... on its own host -> no CORS, fastest.
VITE_API_URL=

# Only used by the dev-server proxy. Harmless in production.
VITE_CMS_URL=https://qualcus.com
